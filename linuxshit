sudo nano /etc/systemd/system/discord-bot.service

[Unit]
Description=Discord QOTD Bot
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/comrade/Documents/GitHub/DiscordBot
ExecStart=/home/comrade/Documents/GitHub/DiscordBot/venv/bin/python /home/comrade/Documents/GitHub/DiscordBot/bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

sudo systemctl enable discord-bot.service
sudo systemctl start discord-bot.service